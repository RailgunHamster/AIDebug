<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AIDebug.Sbox</AssemblyName><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies><GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>../Editor/AIDebug/Managed/</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Sandbox.System"><HintPath>$(EngineBin)/managed/Sandbox.System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Engine"><HintPath>$(EngineBin)/managed/Sandbox.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Reflection"><HintPath>$(EngineBin)/managed/Sandbox.Reflection.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="HarmonyX" Version="2.14.0" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.3" />
    <PackageReference Include="MonoMod.Core" Version="1.3.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0" />
  </ItemGroup>
  <Target Name="ValidateEngine" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(EngineBin)/managed/Sandbox.Engine.dll')" Text="Pass /p:EngineBin=path/to/sbox/bin (the parent of managed)." />
  </Target>
</Project>