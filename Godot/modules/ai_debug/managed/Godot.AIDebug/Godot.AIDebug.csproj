<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GodotSourceRoot Condition="'$(GodotSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</GodotSourceRoot>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <NoWarn>$(NoWarn);CS1701;CS1702;IL2026;IL2060;IL2070;IL2072;IL2075</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(GodotSourceRoot)/modules/mono/glue/GodotSharp/GodotSharp/GodotSharp.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <Target Name="ValidateGodotSourceRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GodotSourceRoot)/modules/mono/glue/GodotSharp/GodotSharp/GodotSharp.csproj')" Text="Set /p:GodotSourceRoot to the integrated Godot source directory." />
  </Target>

  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.14.0" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.3" />
    <PackageReference Include="MonoMod.Core" Version="1.3.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

</Project>
