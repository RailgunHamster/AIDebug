+
+// ai_debug: On-demand loading of Godot.AIDebug.dll via AssemblyLoadContext.Default.
+#ifdef MODULE_AI_DEBUG_ENABLED
+namespace {
+using AIDebugResultCallback = void(CORECLR_DELEGATE_CALLTYPE *)(const char16_t *p_utf16_str, int32_t p_len, void *p_user_data);
+using AIDebugManagedEntryFn = int(CORECLR_DELEGATE_CALLTYPE *)(const char16_t *p_dll_path, const char16_t *p_cmd, const char16_t *p_args_json, AIDebugResultCallback p_cb, void *p_user_data);
+
+void CORECLR_DELEGATE_CALLTYPE _ai_debug_receive_string(const char16_t *p_utf16_str, int32_t p_len, void *p_user_data) {
+	String *out_str = static_cast<String *>(p_user_data);
+	if (out_str && p_utf16_str && p_len > 0) {
+		out_str->append_utf16(p_utf16_str, p_len);
+	}
+}
+} // namespace
+
+String GDMono::ai_debug_invoke(const String &p_command, const String &p_args_json) {
+	if (!runtime_initialized) {
+		return "{\"ok\":false,\"error\":\".NET runtime is not initialized in this process.\"}";
+	}
+
+	if (!ai_debug_entry_fn) {
+		Vector<String> candidates;
+		String exe_dir = OS::get_singleton()->get_executable_path().get_base_dir();
+		candidates.push_back(exe_dir.path_join("GodotSharp").path_join("AIDebug").path_join("Godot.AIDebug.dll").simplify_path());
+		candidates.push_back(GodotSharpDirs::get_api_assemblies_dir().path_join("Godot.AIDebug.dll").simplify_path());
+		candidates.push_back(GodotSharpDirs::get_api_assemblies_dir().path_join("AIDebug").path_join("Godot.AIDebug.dll").simplify_path());
+
+		for (const String &c : candidates) {
+			if (FileAccess::exists(c)) {
+				ai_debug_dll_path = c;
+				break;
+			}
+		}
+
+		if (ai_debug_dll_path.is_empty()) {
+			return "{\"ok\":false,\"error\":\"Godot.AIDebug.dll not found in GodotSharp/AIDebug or data directory.\"}";
+		}
+
+		HostFxrCharString dll_path_fxr = str_to_hostfxr(ai_debug_dll_path);
+		void *fn_ptr = nullptr;
+		int rc = -1;
+		// Prefer hdt_get_function_pointer if Godot.AIDebug is in the default probing path, else load via load_assembly_and_get_function_pointer
+		if (ai_debug_saved_get_fn_ptr_fn) {
+			rc = ai_debug_saved_get_fn_ptr_fn(
+					HOSTFXR_STR("Godot.AIDebug.Bootstrap, Godot.AIDebug"),
+					HOSTFXR_STR("ManagedEntry"),
+					UNMANAGEDCALLERSONLY_METHOD,
+					nullptr,
+					nullptr,
+					&fn_ptr);
+		}
+		if ((rc != 0 || fn_ptr == nullptr) && ai_debug_saved_load_assembly_fn) {
+			rc = ai_debug_saved_load_assembly_fn(
+					get_data(dll_path_fxr),
+					HOSTFXR_STR("Godot.AIDebug.Bootstrap, Godot.AIDebug"),
+					HOSTFXR_STR("ManagedEntry"),
+					UNMANAGEDCALLERSONLY_METHOD,
+					nullptr,
+					&fn_ptr);
+		}
+#ifndef TOOLS_ENABLED
+		// ai_debug: Fallback to CoreCLR/MonoVM delegate creation (used on Android Mono JIT)
+		if ((rc != 0 || fn_ptr == nullptr) && coreclr_create_delegate && ai_debug_coreclr_handle) {
+			rc = coreclr_create_delegate(
+					ai_debug_coreclr_handle,
+					ai_debug_domain_id,
+					"Godot.AIDebug",
+					"Godot.AIDebug.Bootstrap",
+					"ManagedEntry",
+					&fn_ptr);
+		}
+#endif
+		if (rc != 0 || fn_ptr == nullptr) {
+			return vformat("{\"ok\":false,\"error\":\"Failed to load Godot.AIDebug.dll (rc=%d).\"}", rc);
+		}
+		ai_debug_entry_fn = fn_ptr;
+	}
+
+	Char16String dll_u16 = ai_debug_dll_path.utf16();
+	Char16String cmd_u16 = p_command.utf16();
+	Char16String args_u16 = p_args_json.utf16();
+
+	String result;
+	AIDebugManagedEntryFn entry = (AIDebugManagedEntryFn)ai_debug_entry_fn;
+	entry(
+			(const char16_t *)dll_u16.get_data(),
+			(const char16_t *)cmd_u16.get_data(),
+			(const char16_t *)args_u16.get_data(),
+			&_ai_debug_receive_string,
+			&result);
+
+	if (result.is_empty()) {
+		return "{\"ok\":false,\"error\":\"Empty response from Godot.AIDebug.\"}";
+	}
+	return result;
+}
+#endif
